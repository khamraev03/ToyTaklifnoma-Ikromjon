# Do'stingiz taklifnomasi uchun sozlamalar. Bu faylni .env deb nusxalang va qiymatlarni to'ldiring.
# Asl taklifnomaning .env qiymatlarini (ayniqsa BOT_TOKEN) bu yerga KO'CHIRMANG.

# PostgreSQL ulanishi (Render'da yangi Postgres baza yarating va "External/Internal Database URL"ni qo'ying)
DATABASE_URL=

# Tilaklar shu jadvalda saqlanadi (asl taklifnomadagi "messages" jadvalidan alohida)
TABLE_NAME=dost_messages

# Telegram xabaridagi sarlavha
COUPLE_NAMES=KUYOV & KELIN

# Telegram (ixtiyoriy). Faqat YANGI bot tokeni bo'lsin, aks holda asl saytning boti buziladi.
BOT_TOKEN=
CHAT_ID=

# Saytning manzili (Render'da avtomatik aniqlanadi, odatda bo'sh qoldirish mumkin)
PUBLIC_URL=
